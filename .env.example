# --- SUPABASE CONFIGURATION (OBRIGATÓRIO)
NEXT_PUBLIC_SUPABASE_URL=seu-projeto-aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua-site-key-publica-do-turnstile

# IDs ou e-mails com acesso gratuito, separados por virgula (opcional)
SPECIAL_ACCESS_IDS=

# --- STRIPE CONFIGURATION (OBRIGATÓRIO PARA PRO)
STRIPE_SECRET_KEY=sua-sk-aqui
STRIPE_WEBHOOK_SECRET=sua-whsec-aqui
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# --- OUTRAS CONFIGURAÇÕES
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.pianify.com.br

# Desative até concluir consentimento do responsável, denúncia e moderação.
NEXT_PUBLIC_SOCIAL_FEATURES_ENABLED=false

# Ative somente depois de substituir os exemplos por depoimentos reais autorizados.
NEXT_PUBLIC_SHOW_VERIFIED_TESTIMONIALS=false

# Identificação pública obrigatória do fornecedor antes do lançamento.
COMPANY_LEGAL_NAME=Razão social da empresa
COMPANY_TAX_ID=00.000.000/0000-00
COMPANY_ADDRESS=Endereço empresarial completo
