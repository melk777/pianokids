{
  "name": "pianify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "node scripts/start-dev.cjs",
    "build": "node scripts/build-song-catalog-index.js && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "test:access": "node --test tests/access-control.test.ts",
    "parse-midi": "node scripts/midi-to-json.js",
    "parse-midi-graded": "node scripts/midi-to-graded-json.js && node scripts/build-song-catalog-index.js",
    "build-song-catalog-index": "node scripts/build-song-catalog-index.js",
    "validate-song-hands": "node scripts/validate-song-hands.js",
    "audit-song-library": "node scripts/audit-song-library.js",
    "audit-player-modes": "node scripts/audit-player-modes.js",
    "qa:responsive": "node scripts/responsive-pianoengine-qa.js",
    "audit-launch-readiness": "node scripts/audit-launch-readiness.js",
    "verify-release-http": "node scripts/verify-release-http.js",
    "repair-song-library:phase1": "node scripts/repair-song-library-phase1.js && node scripts/build-song-catalog-index.js",
    "repair-song-library:phase2": "node scripts/repair-song-library-phase2.js && node scripts/build-song-catalog-index.js",
    "repair-song-library:phase3": "node scripts/repair-song-library-phase3.js && node scripts/build-song-catalog-index.js",
    "audit-song-source-fidelity": "node scripts/audit-song-source-fidelity.js",
    "audit-song-rights": "node scripts/audit-song-rights.js",
    "build-music-pilot": "node scripts/build-pilot-song-library.js && node scripts/build-song-catalog-index.js",
    "audit-music-pilot": "node scripts/audit-pilot-song-library.js",
    "verify-frozen-music-pilot": "node scripts/verify-frozen-music-pilot.js",
    "plan-music-rebuild": "node scripts/plan-song-library-rebuild.js",
    "build-music-rebuild": "node scripts/build-rebuild-song-library.js && node scripts/build-song-catalog-index.js",
    "audit-music-rebuild": "node scripts/audit-rebuild-song-library.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.3.0",
    "pitchy": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.1",
    "stripe": "^21.0.1",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "ws": "^8.21.3"
  }
}
